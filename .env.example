# Ollama Host
OLLAMA_HOST=http://localhost:11434

# Ollama Model for code generation
OLLAMA_MODEL=qwen3-coder:latest

# Ollama Embedding Model
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Code Agent Configuration
CODE_AGENT_MAX_TOOL_ITERATIONS=20
CODE_AGENT_MAX_TOOL_OUTPUT_CHARS=40000
CODE_AGENT_USE_RAG=true
CODE_AGENT_COMPACTION_THRESHOLD_CHARS=80000
CODE_AGENT_COMPACTION_KEEP_RECENT_CHARS=30000
CODE_AGENT_COMPACTION_MIN_MESSAGES=12

# Tavily API Key (optional, for web search)
TAVILY_API_KEY=tvly-...

# OpenRouter API Key (optional, for alternative LLM providers)
OPENROUTER_API_KEY=your_openrouter_api_key_here